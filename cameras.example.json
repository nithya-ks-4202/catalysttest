{
  "poll_interval_seconds": 60,
  "history_days": 30,
  "database_path": "camwatch.db",

  "thresholds": {
    "capacity_warning_percent": 75,
    "capacity_critical_percent": 90,
    "recent_reboot_seconds": 900,
    "write_error_warning": 1
  },

  "defaults": {
    "community": "${SNMP_COMMUNITY}",
    "version": "v2c",
    "timeout": 2.0,
    "retries": 1
  },

  "cameras": [
    {
      "id": "cam-lobby",
      "name": "Lobby North",
      "host": "192.168.1.41",
      "site": "HQ / Ground floor",
      "tags": ["indoor", "entrance"]
    },
    {
      "id": "cam-dock",
      "name": "Loading Dock",
      "host": "192.168.1.42",
      "site": "HQ / Rear",
      "community": "a-different-community"
    },
    {
      "id": "cam-carpark",
      "name": "Car Park Level 2",
      "host": "192.168.1.43",
      "port": 161,
      "site": "Car park",

      "_comment_patterns": "Only needed when the card is not auto-detected. Run the poller with --once -v to see what the camera actually reports.",
      "sd_patterns": ["/mnt/record", "sdcard"]
    },
    {
      "id": "cam-roof",
      "name": "Roof East",
      "host": "192.168.1.44",

      "_comment_index": "Pin the exact hrStorageTable row when the heuristics pick the wrong volume.",
      "sd_storage_index": 3
    },
    {
      "id": "cam-vendor",
      "name": "Warehouse Aisle 4",
      "host": "192.168.1.45",

      "_comment_vendor": "Vendor private-MIB OIDs. These take priority over hrStorageTable when sd_size_oid and sd_used_oid are both set.",
      "sd_size_oid": "1.3.6.1.4.1.99999.1.2.10.0",
      "sd_used_oid": "1.3.6.1.4.1.99999.1.2.11.0",
      "sd_status_oid": "1.3.6.1.4.1.99999.1.2.2.0",
      "sd_health_oid": "1.3.6.1.4.1.99999.1.2.3.0",
      "sd_write_errors_oid": "1.3.6.1.4.1.99999.1.2.4.0"
    },
    {
      "id": "cam-decommissioned",
      "name": "Old Server Room",
      "host": "192.168.1.46",
      "enabled": false
    }
  ]
}
